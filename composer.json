{
    "name": "multiapi/arco-monorepo",
    "description": "Development monorepo for Arco: PHP on AWS Lambda Web Functions",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-zip": "*",
        "aws/aws-sdk-php": "^3.401.1",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "symfony/console": "^7.1 || ^8.0",
        "symfony/filesystem": "^7.1 || ^8.0",
        "symfony/process": "^7.1 || ^8.0"
    },
    "require-dev": {
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "laravel/tinker": "^2.10 || ^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "psy/psysh": "^0.12"
    },
    "replace": {
        "multiapi/arco": "self.version",
        "multiapi/arco-laravel": "self.version",
        "multiapi/arco-secrets": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Multiapi\\Arco\\": "packages/arco/src/",
            "Multiapi\\Arco\\Laravel\\": "packages/arco-laravel/src/",
            "Multiapi\\Arco\\Secrets\\": "packages/arco-secrets/src/",
            "Multiapi\\Arco\\ConsoleRuntime\\": "packages/arco/runtime/console/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Multiapi\\Arco\\Tests\\": "tests/",
            "Multiapi\\Arco\\Tools\\": "tools/"
        }
    },
    "bin": ["packages/arco/bin/arco"],
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": [
            "Composer\\Config::disableProcessTimeout",
            "bin/test-docker integration"
        ],
        "test:e2e": [
            "Composer\\Config::disableProcessTimeout",
            "bin/test-docker e2e"
        ],
        "test:e2e-aws": [
            "Composer\\Config::disableProcessTimeout",
            "bin/test-docker e2e-aws"
        ],
        "test:runtime": "node --test 'packages/arco/runtime/test/*.test.js'",
        "analyse": "phpstan analyse --memory-limit=4G",
        "test:docker": [
            "Composer\\Config::disableProcessTimeout",
            "bin/test-docker all"
        ],
        "test:docker:unit": [
            "Composer\\Config::disableProcessTimeout",
            "bin/test-docker unit"
        ]
    },
    "scripts-descriptions": {
        "test:docker": "Unit tests, runtime tests and PHPStan in a throwaway container (the way to run them)",
        "test:docker:unit": "Unit tests in the container; extra PHPUnit arguments pass through after --",
        "test:integration": "Integration suite (Lambda simulation) in a container with the host's Docker socket",
        "test:e2e": "End-to-end suite: deploys examples/laravel to a throwaway local Floci (AWS emulator) and checks every feature",
        "test:e2e-aws": "Real-AWS end-to-end run against the dedicated E2E account (AWS_PROFILE, ARCO_E2E_ACCOUNT); a dry run unless ARCO_E2E_DRY_RUN=0"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
