#!/usr/bin/env php
<?php declare(strict_types=1);

// Maintainer script: adds a published runtime build to packages/arco/resources/runtime-builds.php.
// Usage: bin/runtime-manifest-add <release-id> [--repo=owner/name] [--from-file=build.json]
// <release-id> is the arco-runtime release id (1.13.0-r3, tag frankenphp-1.13.0-r3); the build is added as
// php<php>-fp<frankenphp>-r<n>. The default build is the newest build of the manifest's default_php.
// When fetching from GitHub, the release metadata is cross-checked (immutable, asset size and digest, including php-linux-aarch64 when build.json has php_cli).
// --from-file skips that check, since there is no release to compare against.

require __DIR__ . '/../vendor/autoload.php';

use Multiapi\Arco\Tools\RuntimeManifestEditor;

$usage = "Usage: bin/runtime-manifest-add <release-id> [--repo=owner/name] [--from-file=build.json]\n";

$id = null;
$repo = 'multi-api/arco-runtime';
$fromFile = null;
foreach (array_slice($argv, 1) as $arg) {
    if (str_starts_with($arg, '--repo=')) {
        $repo = substr($arg, 7);
    } elseif (str_starts_with($arg, '--from-file=')) {
        $fromFile = substr($arg, 12);
    } elseif (str_starts_with($arg, '--') || $id !== null) {
        fwrite(STDERR, $usage);
        exit(1);
    } else {
        $id = $arg;
    }
}
if ($id === null) {
    fwrite(STDERR, $usage);
    exit(1);
}

try {
    RuntimeManifestEditor::assertValidRepository($repo);
} catch (InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

$release = null;
if ($fromFile !== null) {
    $json = (string) file_get_contents($fromFile);
} else {
    $command = sprintf(
        'gh release download %s --repo %s --pattern build.json --output -',
        escapeshellarg("frankenphp-$id"),
        escapeshellarg($repo),
    );
    $json = (string) shell_exec($command);
    $release = json_decode((string) shell_exec(sprintf(
        'gh api %s',
        escapeshellarg("repos/$repo/releases/tags/frankenphp-$id"),
    )), true);
    if (! is_array($release)) {
        fwrite(STDERR, "Could not read release metadata for frankenphp-$id.\n");
        exit(1);
    }
}

$build = json_decode($json, true);
if (! is_array($build) || ($build['id'] ?? null) !== $id) {
    fwrite(STDERR, "Could not read build.json for $id.\n");
    exit(1);
}

try {
    if ($release !== null) {
        RuntimeManifestEditor::assertReleaseMatches($release, $build);
    }
    $manifestPath = __DIR__ . '/../packages/arco/resources/runtime-builds.php';
    $before = Multiapi\Arco\Binary\RuntimeManifest::load($manifestPath)->resolve(null, null);
    $added = RuntimeManifestEditor::add($manifestPath, $build, $repo);
    $after = Multiapi\Arco\Binary\RuntimeManifest::load($manifestPath)->resolve(null, null);
    $default = $after->id;
    $major = static fn (string $version): string => explode('.', $version)[0];
    if ($major($before->frankenphp) !== $major($after->frankenphp)) {
        fwrite(STDERR, "Warning: the default build moves from FrankenPHP {$before->frankenphp} to {$after->frankenphp}, a new FrankenPHP major. This needs the owner's sign-off before the release (docs/maintainers/runtime-builds.md).\n");
    }
} catch (InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

echo "Added $added (release frankenphp-$id)" . ($default === $added ? '; it is the new default build' : "; the default build stays $default") . "\n";
